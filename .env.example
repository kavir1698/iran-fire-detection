# NASA FIRMS API Configuration
NASA_FIRMS_KEY=your_firms_map_key_here

# Telegram Alert Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=@your_channel_or_group_id

# Copernicus Data Space Ecosystem (CDSE) Credentials
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Custom Smoke Detection Model (YOLOv8 .pt weights)
# Optional: direct download URL for a custom-trained fire/smoke detection model.
# If unset, the pipeline auto-downloads a free forest-fire model from Hugging Face (~22 MB).
# Set this only if you have your own trained model to use instead.
# SMOKE_MODEL_URL=https://your-storage.com/fire-smoke-model.pt
